#!/usr/bin/env python3
"""voice — press a hotkey, speak, and the words are typed into the focused window.

Linux system-wide dictation. Records with PipeWire/PulseAudio, transcribes with a
cloud model (Groq) or a local whisper.cpp model, then types the result.

  voice                 toggle: start listening / stop + transcribe + type
  voice start | stop | cancel | status
  voice --file x.wav    transcribe an audio file and type it
  voice --no-type ...   print the transcript, don't touch the keyboard
  voice --engine local  force the offline whisper.cpp engine
  voice --set-key       store a Groq API key
"""
from __future__ import annotations

import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.request

VERSION = "1.1.0"

# repo layout: <repo>/bin/voice, <repo>/lib/inject.py
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
INJECT = os.path.join(os.path.dirname(SCRIPT_DIR), "lib", "inject.py")

# local engine data (models, whisper.cpp build) — not part of the repo
DATA_HOME = os.environ.get("VOICE_HOME", os.path.expanduser("~/.local/share/voice-input"))
WHISPER = os.path.join(DATA_HOME, "whisper.cpp", "build", "bin", "whisper-cli")
MODELS = os.path.join(DATA_HOME, "models")

RATE = 16000
CONFIG = os.path.expanduser("~/.config/voice-input/config.json")
GROQ_URL = os.environ.get("VOICE_GROQ_URL", "https://api.groq.com/openai/v1/audio/transcriptions")
GROQ_MODEL = os.environ.get("VOICE_GROQ_MODEL", "whisper-large-v3-turbo")

STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/voice-{os.getuid()}"), "voice-input")
WAV = os.path.join(STATE, "rec.wav")
PIDF = os.path.join(STATE, "rec.pid")
LOCK = os.path.join(STATE, "lock")


# --------------------------------------------------------------------------- #
# config / notifications
# --------------------------------------------------------------------------- #
def load_config() -> dict:
    try:
        with open(CONFIG, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_config(cfg: dict) -> None:
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w", encoding="utf-8") as fh:
        json.dump(cfg, fh, indent=2)
    os.chmod(CONFIG, 0o600)


NOTIFY_ID = os.path.join(STATE, "notify.id")
NOTIFY_MODE = "minimal"    # minimal | full | errors | off   (set in main)


def _stored_id() -> int:
    try:
        return int(open(NOTIFY_ID).read().strip())
    except (OSError, ValueError):
        return 0


def _save_id(nid: int) -> None:
    try:
        open(NOTIFY_ID, "w").write(str(nid))
    except OSError:
        pass


def _close_notification() -> None:
    """Dismiss the transient status toast immediately instead of waiting it out."""
    nid = _stored_id()
    if not nid:
        return
    try:
        subprocess.run(
            ["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
             "--object-path=/org/freedesktop/Notifications",
             "--method=org.freedesktop.Notifications.CloseNotification", str(nid)],
            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    try:
        os.unlink(NOTIFY_ID)
    except OSError:
        pass


def _send(msg: str, title: str, transient: bool, timeout: int, replace_id: int = 0) -> int:
    cmd = ["notify-send", "-a", "Voice", "-t", str(timeout), "-p"]
    if transient:
        cmd.append("-e")            # don't persist in the notification center
    if replace_id:
        cmd += ["-r", str(replace_id)]
    cmd += [title, msg]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        return int((r.stdout or "0").strip() or 0)
    except (FileNotFoundError, ValueError, subprocess.TimeoutExpired):
        return 0


def notify(msg: str, title: str = "Voice input", level: str = "status") -> None:
    """level: status | warn | info | error.

    minimal (default): one transient toast that is replaced, never in the tray.
    full:              persistent toasts, including the transcript preview.
    errors:            only failures notify.
    off:               absolutely nothing — silent dictation.
    """
    print(msg, file=sys.stderr, flush=True)
    if NOTIFY_MODE == "off":
        return                      # nothing at all reaches the notification daemon
    if level == "error":
        _send(msg, title, transient=False, timeout=5000)
        return
    if NOTIFY_MODE == "errors":
        return
    if level == "info" and NOTIFY_MODE != "full":
        return
    if NOTIFY_MODE == "full":
        _send(msg, title, transient=False, timeout=2500)
        return
    _save_id(_send(msg, title, transient=True, timeout=1500,
                   replace_id=_stored_id()))


def ensure_state() -> None:
    os.makedirs(STATE, exist_ok=True)


def lock():
    ensure_state()
    fh = open(LOCK, "w")
    fcntl.flock(fh, fcntl.LOCK_EX)
    return fh


# --------------------------------------------------------------------------- #
# recording
# --------------------------------------------------------------------------- #
def recording_pid() -> int | None:
    try:
        pid = int(open(PIDF).read().strip())
    except (OSError, ValueError):
        return None
    try:
        os.kill(pid, 0)
        return pid
    except OSError:
        return None


def start() -> int:
    if recording_pid():
        notify("already listening", level="warn")
        return 0
    ensure_state()
    if os.path.exists(WAV):
        os.unlink(WAV)
    proc = subprocess.Popen(
        ["parecord", "--format=s16le", f"--rate={RATE}", "--channels=1",
         "--file-format=wav", WAV],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    open(PIDF, "w").write(str(proc.pid))
    notify("\U0001F3A4 listening…")
    return 0


def stop_recording() -> bool:
    pid = recording_pid()
    if not pid:
        return False
    try:
        os.kill(pid, signal.SIGINT)
    except OSError:
        pass
    for _ in range(100):          # parecord needs a moment to finalise the wav header
        if not recording_pid():
            break
        time.sleep(0.05)
    try:
        os.unlink(PIDF)
    except OSError:
        pass
    return os.path.exists(WAV) and os.path.getsize(WAV) > 44


# --------------------------------------------------------------------------- #
# transcription
# --------------------------------------------------------------------------- #
def clean(txt: str) -> str:
    txt = re.sub(r"\[[^\]]*\]|\([^)]*\)", " ", txt)   # [BLANK_AUDIO], (music)
    return re.sub(r"\s+", " ", txt).strip(" -")


def groq_key() -> str:
    return os.environ.get("GROQ_API_KEY") or load_config().get("groq_api_key", "")


def transcribe_cloud(wav: str, language: str) -> str:
    key = groq_key()
    if not key:
        raise RuntimeError("no Groq API key")
    boundary = "----voiceinput" + str(int(time.time()))
    with open(wav, "rb") as fh:
        audio = fh.read()
    fields = {
        "model": GROQ_MODEL,
        "language": language,
        "response_format": "json",
        "temperature": "0",
        "prompt": "Transcribe verbatim. Keep punctuation and casing.",
    }
    body = b""
    for k, v in fields.items():
        body += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n").encode()
    body += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; "
             f"filename=\"audio.wav\"\r\nContent-Type: audio/wav\r\n\r\n").encode()
    body += audio + f"\r\n--{boundary}--\r\n".encode()

    req = urllib.request.Request(GROQ_URL, data=body, method="POST", headers={
        "Authorization": f"Bearer {key}",
        "Content-Type": f"multipart/form-data; boundary={boundary}",
        "User-Agent": f"voice-dictation/{VERSION}",
    })
    with urllib.request.urlopen(req, timeout=45) as resp:
        payload = json.loads(resp.read().decode())
    return clean(payload.get("text", ""))


def transcribe_local(wav: str, model: str, language: str) -> str:
    if not os.path.exists(WHISPER):
        raise SystemExit(
            f"local engine not installed ({WHISPER}).\n"
            "Install it with:  ./install.sh --local"
        )
    mpath = os.path.join(MODELS, f"ggml-{model}.bin")
    if not os.path.exists(mpath):
        raise SystemExit(f"model missing: {mpath} (./install.sh --local)")
    out_prefix = os.path.join(STATE, "out")
    try:
        os.unlink(out_prefix + ".txt")
    except OSError:
        pass
    threads = str(min(4, max(1, (os.cpu_count() or 4) // 2)))
    cmd = ["nice", "-n", "15", WHISPER, "-m", mpath, "-f", wav, "-l", language,
           "-nt", "-otxt", "-of", out_prefix, "-t", threads, "-np"]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"whisper-cli failed ({r.returncode}): {(r.stderr or r.stdout)[-400:]}")
    return clean(open(out_prefix + ".txt", encoding="utf-8", errors="replace").read())


def transcribe(wav: str, model: str, engine: str, language: str) -> str:
    key_available = bool(groq_key())
    if engine == "cloud" and not key_available:
        raise RuntimeError("no Groq API key — run: voice --set-key")
    if engine in ("auto", "cloud") and key_available:
        try:
            return transcribe_cloud(wav, language)
        except Exception as exc:
            if engine == "cloud":
                raise RuntimeError(f"cloud transcription failed: {exc}") from exc
            notify(f"cloud unavailable ({exc}) — using local model", level="warn")
    return transcribe_local(wav, model, language)


# --------------------------------------------------------------------------- #
# typing
# --------------------------------------------------------------------------- #
def type_into_focus(text: str) -> bool:
    r = subprocess.run([sys.executable, INJECT, text], check=False)
    return r.returncode == 0


# --------------------------------------------------------------------------- #
# main
# --------------------------------------------------------------------------- #
def main(argv: list[str]) -> int:
    ensure_state()
    args = list(argv)

    if args[:1] in (["--version"], ["-v"]):
        print(VERSION)
        return 0

    if args[:1] == ["--set-key"]:
        key = args[1] if len(args) > 1 else input("Groq API key (gsk_...): ").strip()
        if not key.startswith("gsk_"):
            print("that does not look like a Groq key (should start with gsk_)", file=sys.stderr)
            return 2
        cfg = load_config()
        cfg["groq_api_key"] = key
        save_config(cfg)
        print(f"saved to {CONFIG} (mode 600)")
        return 0

    cfg = load_config()
    no_type = "--no-type" in args
    args = [a for a in args if a != "--no-type"]

    def take(flag: str, default: str) -> str:
        if flag in args:
            i = args.index(flag)
            try:
                val = args[i + 1]
                del args[i:i + 2]
                return val
            except IndexError:
                raise SystemExit(f"{flag} needs a value")
        return default

    engine = take("--engine", os.environ.get("VOICE_ENGINE", "auto"))
    model = take("--model", os.environ.get("VOICE_MODEL", cfg.get("local_model", "base.en")))
    language = take("--lang", os.environ.get("VOICE_LANG", cfg.get("language", "en")))
    audio_file = take("--file", "")

    global NOTIFY_MODE
    NOTIFY_MODE = take("--notify", os.environ.get("VOICE_NOTIFY") or cfg.get("notify", "minimal"))
    if NOTIFY_MODE not in ("minimal", "full", "errors", "off"):
        raise SystemExit(
            f"--notify must be minimal, full, errors or off (got {NOTIFY_MODE!r})")

    cmd = args[0] if args else "toggle"

    if audio_file:
        try:
            text = transcribe(audio_file, model, engine, language)
        except Exception as exc:
            print(f"transcription failed: {exc}", file=sys.stderr)
            notify(f"transcription failed: {str(exc)[:120]}", level="error")
            return 1
        if not text:
            notify("no speech detected", level="warn")
            return 1
        if no_type:
            print(text)
        else:
            notify(f"“{text[:60]}”", level="info")
            type_into_focus(text)
        _close_notification()
        return 0

    if cmd == "status":
        print("listening" if recording_pid() else "idle")
        return 0

    if cmd == "start":
        lock()
        return start()

    if cmd == "cancel":
        lock()
        pid = recording_pid()
        if pid:
            try:
                os.kill(pid, signal.SIGINT)
            except OSError:
                pass
            try:
                os.unlink(PIDF)
            except OSError:
                pass
        notify("cancelled", level="warn")
        return 0

    if cmd == "stop":
        lock()
        return _stop_and_type(model, no_type, engine, language)

    if cmd == "toggle":
        lock()
        if recording_pid():
            return _stop_and_type(model, no_type, engine, language)
        return start()

    print(__doc__)
    return 2


def _stop_and_type(model: str, no_type: bool, engine: str, language: str) -> int:
    if not stop_recording():
        notify("nothing recorded", level="warn")
        return 1
    notify("transcribing…")
    try:
        text = transcribe(WAV, model, engine, language)
    except Exception as exc:
        notify(f"transcription failed: {str(exc)[:120]}", level="error")
        return 1
    if not text:
        notify("no speech detected", level="warn")
        return 1
    open(os.path.join(STATE, "last.txt"), "w", encoding="utf-8").write(text)
    if no_type:
        print(text)
        _close_notification()
        return 0
    notify(f"“{text[:70]}”", level="info")
    if not type_into_focus(text):
        notify("could not type into the focused window", level="error")
        print(text)
        return 1
    _close_notification()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
